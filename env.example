# Copie para .env e preencha. O arquivo .env NAO vai para o repositorio.
# Somente o backend le estas variaveis; nenhuma delas vai para o cliente.

# Chave da API de visao (obrigatoria para descrever de verdade).
VISION_API_KEY=

# Endpoint compativel com OpenAI (a barra final e opcional).
VISION_API_BASE=https://api.openai.com/v1

# Modelo de visao-linguagem.
VISION_MODEL=gpt-4o-mini

# Padroes do menu Configuracoes do site (cada pessoa pode mudar no proprio navegador).
# Tamanho da descricao: short, medium, long ou full.
DEFAULT_DETAIL=medium
# Descrever pessoas (posicao, roupas, acao; nunca identidade): true ou false.
DEFAULT_PEOPLE=false
# Voz padrao: device (voz do aparelho), o nome do arquivo Piper (ex.: pt_BR-faber-medium)
# ou cloud:<id da voz> de TTS_MODEL_IDS.
DEFAULT_VOICE=device

# Abaixo deste valor, o app responde "Nao sei" em vez de inventar.
CONFIDENCE_THRESHOLD=0.35

# Tempo maximo para conectar e enviar a foto ao modelo, em segundos (por tentativa).
VISION_TIMEOUT_CONNECTION=10
# Tempo maximo esperando a resposta do modelo depois de enviar, em segundos (por tentativa).
VISION_TIMEOUT_REQUEST=60
# Quantas vezes tentar o modelo quando ele esta ocupado ou fora do ar (1 a 30).
# Pausa entre tentativas: 1,5 s, 3 s, 6 s e depois 10 s.
VISION_ATTEMPTS=3

# Limite de requisicoes por janela e tamanho da janela (segundos).
RATE_LIMIT_PER_MINUTE=10
RATE_WINDOW_S=60

# Tamanho maximo da imagem recebida pelo proxy (bytes).
MAX_IMAGE_BYTES=1500000

# Voz Piper (gerada no servidor). Pasta com os arquivos .onnx e .onnx.json.
PIPER_VOICES_DIR=models/piper
PIPER_VOICE=pt_BR-faber-medium

# Limite de pedidos de fala por janela e tamanho maximo do texto falado.
SPEAK_RATE_LIMIT_PER_MINUTE=60
MAX_SPEAK_CHARS=4000

# Vozes na nuvem (OpenRouter /audio/speech). Sem TTS_MODEL, elas nao aparecem.
# TTS_MODEL_IDS: lista <id da voz>:<nome>, separada por virgulas. O nome vira a pasta em audios/.
TTS_MODEL=fish-audio/s2.1-pro-free:free
TTS_MODEL_IDS=
# Opcional: por padrao usa VISION_API_KEY e VISION_API_BASE.
TTS_API_KEY=
TTS_API_BASE=
TTS_TIMEOUT_S=20

# Pasta onde ficam os audios das frases fixas, ja gerados (audios/<nome da voz>/).
AUDIO_CACHE_DIR=audios

# Portas usadas por "npm start".
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=5173

# Defina DEV_HTTPS=1 para servir o front em HTTPS (camera em celular na rede local).
DEV_HTTPS=0
